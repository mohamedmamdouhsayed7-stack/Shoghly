# Copy into a local ignored env file; use a dedicated disposable PostgreSQL database.
APP_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://127.0.0.1:3000
DATABASE_URL=postgresql://shoghly:replace-me@127.0.0.1:55432/shoghly_backend_disposable?schema=public
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# REQUIRED after product owner confirmation: "submission" or "approval".
# Leave blank until the multiplier snapshot point is confirmed; reward approvals fail closed.
REWARD_MULTIPLIER_SNAPSHOT_POLICY=

# TEST_DATABASE_URL must point to a separate disposable database, never the app database.
TEST_DATABASE_URL=postgresql://shoghly_test:replace-me@127.0.0.1:55433/shoghly_backend_test?schema=public
