generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DISABLED

  @@map("account_status")
}

enum TaskStatus {
  DRAFT
  ACTIVE
  INACTIVE

  @@map("task_status")
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("submission_status")
}

enum ReservationStatus {
  RESERVED
  CONSUMED
  RELEASED

  @@map("reservation_status")
}

enum QuotaSource {
  FREE_LIFETIME
  SUBSCRIPTION

  @@map("quota_source")
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  REVOKED

  @@map("subscription_status")
}

enum RewardTransactionType {
  TASK_APPROVAL
  ADJUSTMENT
  REVERSAL

  @@map("reward_transaction_type")
}

enum IdempotencyStatus {
  STARTED
  COMPLETED

  @@map("idempotency_status")
}

model User {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String              @unique @db.VarChar(320)
  displayName   String              @map("display_name") @db.VarChar(100)
  passwordHash  String              @map("password_hash") @db.VarChar(200)
  status        AccountStatus       @default(PENDING)
  emailVerifiedAt DateTime?         @map("email_verified_at") @db.Timestamptz(6)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  tasks         Task[]              @relation("TaskCreator")
  submissions   Submission[]        @relation("SubmissionWorker")
  reviews       Submission[]        @relation("SubmissionReviewer")
  subscriptions Subscription[]
  quotaGrants   QuotaGrant[]
  approvalGate  ApprovalGate?
  rewardEntries RewardTransaction[]
  notifications Notification[]
  auditEvents   AuditLog[]          @relation("AuditActor")
  idempotency   IdempotencyRecord[]
  roles         UserRole[]
  sessions      AuthSession[]
  emailTokens   AuthEmailToken[]

  @@map("users")
}

model Role {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String           @unique @db.VarChar(64)
  description String           @db.VarChar(300)
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String           @unique @db.VarChar(100)
  description String           @db.VarChar(300)
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  assignedBy String?  @map("assigned_by") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId, userId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId, roleId])
  @@map("role_permissions")
}

model AuthSession {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  familyId   String    @map("family_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  userAgent  String?   @map("user_agent") @db.VarChar(500)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens AuthRefreshToken[]

  @@index([userId, revokedAt, expiresAt])
  @@index([familyId])
  @@map("auth_sessions")
}

model AuthRefreshToken {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId   String    @map("session_id") @db.Uuid
  familyId    String    @map("family_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt  DateTime? @map("consumed_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedById String?  @unique @map("replaced_by_id") @db.Uuid
  session     AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([familyId, consumedAt, revokedAt])
  @@index([sessionId, expiresAt])
  @@map("auth_refresh_tokens")
}

model AuthEmailToken {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash") @db.Char(64)
  purpose    String   @db.VarChar(24)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
  @@map("auth_email_tokens")
}

model AuthRateLimit {
  keyHash     String   @id @map("key_hash") @db.Char(64)
  windowStart DateTime @map("window_start") @db.Timestamptz(6)
  attempts    Int      @default(0)
  blockedUntil DateTime? @map("blocked_until") @db.Timestamptz(6)

  @@map("auth_rate_limits")
}

model Task {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdById    String        @map("created_by_id") @db.Uuid
  status         TaskStatus    @default(DRAFT)
  expiresAt      DateTime?     @map("expires_at") @db.Timestamptz(6)
  currentVersion Int           @default(1) @map("current_version")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  creator        User          @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  versions       TaskVersion[]
  submissions    Submission[]

  @@index([status, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("tasks")
}

model TaskVersion {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId           String       @map("task_id") @db.Uuid
  version          Int
  title            String       @db.VarChar(100)
  summary          String       @db.VarChar(220)
  description      String       @db.VarChar(4000)
  externalUrl      String       @map("external_url") @db.VarChar(2048)
  instructions     String       @db.VarChar(4000)
  rewardBaseIqd    Int          @default(250) @map("reward_base_iqd")
  evidenceRequired Boolean      @default(true) @map("evidence_required")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  task             Task         @relation(fields: [taskId], references: [id], onDelete: Restrict)
  submissions      Submission[]

  @@unique([taskId, version])
  @@unique([taskId, id])
  @@map("task_versions")
}

model Submission {
  id                     String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId                 String               @map("task_id") @db.Uuid
  taskVersion            Int                  @map("task_version")
  workerId               String               @map("worker_id") @db.Uuid
  status                 SubmissionStatus     @default(PENDING)
  submittedAt            DateTime             @default(now()) @map("submitted_at") @db.Timestamptz(6)
  reviewedAt             DateTime?            @map("reviewed_at") @db.Timestamptz(6)
  reviewedById           String?              @map("reviewed_by_id") @db.Uuid
  rejectionReason        String?              @map("rejection_reason") @db.VarChar(1000)
  multiplierPolicy       String?              @map("multiplier_policy") @db.VarChar(16)
  multiplierSnapshot     Decimal?             @map("multiplier_snapshot") @db.Decimal(12, 4)
  subscriptionSnapshotId String?              @map("subscription_snapshot_id") @db.Uuid
  task                   Task                 @relation(fields: [taskId], references: [id], onDelete: Restrict)
  version                TaskVersion          @relation(fields: [taskId, taskVersion], references: [taskId, version], onDelete: Restrict)
  worker                 User                 @relation("SubmissionWorker", fields: [workerId], references: [id], onDelete: Restrict)
  reviewer               User?                @relation("SubmissionReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  evidence               SubmissionEvidence[]
  reservation            Reservation?
  rewards                RewardTransaction[]
  subscriptionSnapshot   Subscription?        @relation("SubmissionSubscriptionSnapshot", fields: [subscriptionSnapshotId], references: [id], onDelete: Restrict)

  @@index([status, submittedAt])
  @@index([workerId, submittedAt(sort: Desc)])
  @@index([taskId, workerId])
  @@map("submissions")
}

model SubmissionEvidence {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submissionId String     @map("submission_id") @db.Uuid
  kind         String     @db.VarChar(16)
  textValue    String?    @map("text_value") @db.VarChar(2000)
  urlValue     String?    @map("url_value") @db.VarChar(2048)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Restrict)

  @@index([submissionId, createdAt])
  @@map("submission_evidence")
}

model Subscription {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String              @map("user_id") @db.Uuid
  status             SubscriptionStatus  @default(PENDING)
  rewardMultiplier   Decimal             @map("reward_multiplier") @db.Decimal(12, 4)
  startsAt           DateTime?           @map("starts_at") @db.Timestamptz(6)
  endsAt             DateTime?           @map("ends_at") @db.Timestamptz(6)
  verifiedAt         DateTime?           @map("verified_at") @db.Timestamptz(6)
  sourceReference    String?             @unique @map("source_reference") @db.VarChar(200)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  user               User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  quotaGrants        QuotaGrant[]
  rewardSnapshots    Submission[]        @relation("SubmissionSubscriptionSnapshot")
  rewardTransactions RewardTransaction[]

  @@index([userId, status, endsAt])
  @@map("subscriptions")
}

model QuotaGrant {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  source          QuotaSource
  sourceReference String?       @map("source_reference") @db.VarChar(200)
  grantedUnits    Int           @map("granted_units")
  reservedUnits   Int           @default(0) @map("reserved_units")
  consumedUnits   Int           @default(0) @map("consumed_units")
  expiredUnits    Int           @default(0) @map("expired_units")
  revokedUnits    Int           @default(0) @map("revoked_units")
  expiresAt       DateTime?     @map("expires_at") @db.Timestamptz(6)
  revokedAt       DateTime?     @map("revoked_at") @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  user            User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  reservations    Reservation[]
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id])
  subscriptionId  String?       @map("subscription_id") @db.Uuid

  @@unique([userId, source, sourceReference])
  @@index([userId, source, expiresAt])
  @@map("quota_grants")
}

model Reservation {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submissionId String            @unique @map("submission_id") @db.Uuid
  quotaGrantId String            @map("quota_grant_id") @db.Uuid
  status       ReservationStatus @default(RESERVED)
  reservedAt   DateTime          @default(now()) @map("reserved_at") @db.Timestamptz(6)
  resolvedAt   DateTime?         @map("resolved_at") @db.Timestamptz(6)
  submission   Submission        @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  quotaGrant   QuotaGrant        @relation(fields: [quotaGrantId], references: [id], onDelete: Restrict)

  @@index([quotaGrantId, status])
  @@map("reservations")
}

model ApprovalGate {
  userId         String    @id @map("user_id") @db.Uuid
  lastApprovedAt DateTime? @map("last_approved_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user           User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("approval_gates")
}

model RewardTransaction {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String                @map("user_id") @db.Uuid
  submissionId   String                @map("submission_id") @db.Uuid
  subscriptionId String?               @map("subscription_id") @db.Uuid
  type           RewardTransactionType
  amountIqd      Int                   @map("amount_iqd")
  baseRewardIqd  Int                   @map("base_reward_iqd")
  multiplier     Decimal               @db.Decimal(12, 4)
  idempotencyKey String                @unique @map("idempotency_key") @db.VarChar(200)
  originalId     String?               @map("original_id") @db.Uuid
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  user           User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  submission     Submission            @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  subscription   Subscription?         @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  original       RewardTransaction?    @relation("RewardReversal", fields: [originalId], references: [id], onDelete: Restrict)
  reversals      RewardTransaction[]   @relation("RewardReversal")

  @@index([userId, createdAt(sort: Desc)])
  @@map("reward_transactions")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(100)
  targetType String   @map("target_type") @db.VarChar(50)
  targetId   String?  @map("target_id") @db.VarChar(100)
  requestId  String   @map("request_id") @db.VarChar(100)
  details    Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt(sort: Desc)])
  @@index([targetType, targetId, createdAt(sort: Desc)])
  @@map("audit_log")
}

model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  kind      String    @db.VarChar(80)
  payload   Json      @default("{}")
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@map("notifications")
}

model IdempotencyRecord {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId     String            @map("actor_id") @db.Uuid
  key         String            @db.VarChar(200)
  requestHash String            @map("request_hash") @db.Char(64)
  status      IdempotencyStatus @default(STARTED)
  response    Json?
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt DateTime?         @map("completed_at") @db.Timestamptz(6)
  actor       User              @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([actorId, key])
  @@index([createdAt])
  @@map("idempotency_records")
}
