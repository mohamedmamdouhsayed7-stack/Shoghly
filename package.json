{
  "name": "shoghly",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.20.0 <25",
    "npm": ">=11.19.0 <12"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "install:frontend": "npm ci",
    "install:backend": "npm --prefix backend ci",
    "install:all": "npm ci && npm --prefix backend ci",
    "dev": "next dev",
    "demo": "node scripts/start-demo.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:demo": "playwright test --config playwright.demo.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "backend:start:dev": "npm --prefix backend run start:dev",
    "backend:build": "npm --prefix backend run build",
    "backend:lint": "npm --prefix backend run lint",
    "backend:test": "npm --prefix backend test",
    "backend:prisma:validate": "npm --prefix backend run prisma:validate",
    "backend:prisma:generate": "npm --prefix backend run prisma:generate",
    "backend:prisma:migrate:dev": "npm --prefix backend run prisma:migrate:dev",
    "bootstrap:admin": "node --env-file-if-exists=.env.local scripts/bootstrap-admin.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.0",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "supabase": "3.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vitest": "4.1.12"
  }
}
